{% extends "base.html.j2" %}
{% block body %}<p>Hi {{ first_name }},</p><p>Thank you for your order <strong>{{ order_number }}</strong>.</p><table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;">{% for item in items %}<tr><td>{{ item.name }} &times; {{ item.quantity }}</td><td align="right">{{ item.total }}</td></tr>{% endfor %}<tr><td style="border-top:1px solid #e4e7ec;"><strong>Total</strong></td><td align="right" style="border-top:1px solid #e4e7ec;"><strong>{{ total }}</strong></td></tr></table>{% endblock %}
