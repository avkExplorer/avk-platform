{% extends "base.html.j2" %}
{% block body %}<p>Hi {{ first_name }},</p><p>We received a request to reset your password. The link works for {{ expires_in }}.</p><p style="margin:24px 0;"><a href="{{ reset_url }}" style="background:#2457d6;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:6px;display:inline-block;">Choose a new password</a></p><p style="font-size:14px;color:#5a6472;">If you did not ask for this, ignore this email; your password stays the same.</p>{% endblock %}
