<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ subject }}</title></head>
<body style="margin:0;padding:24px 16px;background:#f6f7f9;font:16px/1.6 -apple-system,'Segoe UI',Arial,sans-serif;color:#14181f;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center">
    <table role="presentation" width="100%" style="max-width:560px;background:#ffffff;border-radius:8px;padding:28px;" cellpadding="0" cellspacing="0">
      <tr><td>
        <p style="margin:0 0 20px;font-size:18px;font-weight:600;">{{ brand_name }}</p>
        {% block body %}{% endblock %}
        <hr style="border:none;border-top:1px solid #e4e7ec;margin:28px 0 16px;">
        <p style="margin:0;font-size:13px;color:#5a6472;">
          Questions? Reply to this email or write to {{ support_email }}.<br>
          {{ brand_name }}{% if postal_address %} &middot; {{ postal_address }}{% endif %}
        </p>
      </td></tr>
    </table>
  </td></tr></table>
</body>
</html>
